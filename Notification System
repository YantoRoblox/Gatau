local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer
local PlayerGui = (gethui and gethui()) or game:GetService("CoreGui")

local NotificationGui = Instance.new("ScreenGui")
NotificationGui.Name = "YantoHub_Notifications"
NotificationGui.Parent = PlayerGui
NotificationGui.ResetOnSpawn = false

local activeNotifications = {}
local activeStrokes = {}
local notificationCount = 0

local NOTIFICATION_WIDTH = 280
local NOTIFICATION_HEIGHT = 75
local NOTIFICATION_SPACING = 10
local SLIDE_DISTANCE = 400
local ANIMATION_SPEED = 0.5

local function playSound(soundId)
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Parent = SoundService
    sound.Volume = 1.5
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

RunService.RenderStepped:Connect(function()
    local color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
    for i = #activeStrokes, 1, -1 do
        local stroke = activeStrokes[i]
        if stroke and stroke.Parent then
            stroke.Color = color
        else
            table.remove(activeStrokes, i)
        end
    end
end)

local function createNotification(title, content, duration)
    notificationCount = notificationCount + 1
    
    local notificationFrame = Instance.new("Frame")
    notificationFrame.Name = "Notif_" .. notificationCount
    notificationFrame.Size = UDim2.new(0, NOTIFICATION_WIDTH, 0, NOTIFICATION_HEIGHT)
    notificationFrame.BackgroundColor3 = Color3.fromRGB(25, 5, 5)
    notificationFrame.BackgroundTransparency = 0.1
    notificationFrame.Parent = NotificationGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = notificationFrame
    
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = notificationFrame
    table.insert(activeStrokes, stroke)
    
    playSound("18723584764")
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -50, 0, 24)
    titleLabel.Position = UDim2.new(0, 12, 0, 8)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title:upper()
    titleLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
    titleLabel.TextSize = 14
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = notificationFrame
    
    local contentLabel = Instance.new("TextLabel")
    contentLabel.Size = UDim2.new(1, -50, 0, 25)
    contentLabel.Position = UDim2.new(0, 12, 0, 30)
    contentLabel.BackgroundTransparency = 1
    contentLabel.Text = content
    contentLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    contentLabel.TextSize = 12
    contentLabel.Font = Enum.Font.Gotham
    contentLabel.TextWrapped = true
    contentLabel.TextXAlignment = Enum.TextXAlignment.Left
    contentLabel.TextYAlignment = Enum.TextYAlignment.Top
    contentLabel.Parent = notificationFrame
    
    local progressBack = Instance.new("Frame")
    progressBack.Size = UDim2.new(1, -24, 0, 3)
    progressBack.Position = UDim2.new(0, 12, 1, -10)
    progressBack.BackgroundColor3 = Color3.fromRGB(50, 0, 0)
    progressBack.BorderSizePixel = 0
    progressBack.Parent = notificationFrame
    
    Instance.new("UICorner", progressBack).CornerRadius = UDim.new(1, 0)
    
    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(1, 0, 1, 0)
    progressBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    progressBar.BorderSizePixel = 0
    progressBar.Parent = progressBack
    
    Instance.new("UICorner", progressBar).CornerRadius = UDim.new(1, 0)
    
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 30, 0, 30)
    closeButton.Position = UDim2.new(1, -35, 0, 5)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = "×"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextSize = 24
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = notificationFrame
    
    local yPos = (#activeNotifications * (NOTIFICATION_HEIGHT + NOTIFICATION_SPACING)) + 60
    notificationFrame.Position = UDim2.new(1, SLIDE_DISTANCE, 0, yPos)
    table.insert(activeNotifications, notificationFrame)
    
    local function updatePositions()
        for i, notif in ipairs(activeNotifications) do
            local newY = ((i - 1) * (NOTIFICATION_HEIGHT + NOTIFICATION_SPACING)) + 60
            TweenService:Create(notif, TweenInfo.new(ANIMATION_SPEED, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(1, -NOTIFICATION_WIDTH - 20, 0, newY)
            }):Play()
        end
    end
    
    TweenService:Create(notificationFrame, TweenInfo.new(ANIMATION_SPEED, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -NOTIFICATION_WIDTH - 20, 0, yPos)
    }):Play()
    
    local function removeNotification()
        local index = table.find(activeNotifications, notificationFrame)
        if index then table.remove(activeNotifications, index) end
        
        local outTween = TweenService:Create(notificationFrame, TweenInfo.new(ANIMATION_SPEED, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, SLIDE_DISTANCE, 0, notificationFrame.Position.Y.Offset),
            BackgroundTransparency = 1
        })
        
        outTween:Play()
        outTween.Completed:Connect(function()
            notificationFrame:Destroy()
            updatePositions()
        end)
    end
    
    closeButton.MouseButton1Click:Connect(removeNotification)
    
    if duration and duration > 0 then
        local pTween = TweenService:Create(progressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)})
        pTween:Play()
        pTween.Completed:Connect(function()
            if notificationFrame.Parent then removeNotification() end
        end)
    end
end

getgenv().Notify = function(options)
    task.spawn(function()
        createNotification(options.Title or "YANTO HUB", options.Content or "Notification", options.Duration or 5)
    end)
end
